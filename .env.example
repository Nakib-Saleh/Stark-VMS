# Environment variables the API reads. Spring does not load this file:
# set these in your host's dashboard (Render) or your shell. Leave them unset locally
# to use the defaults in backend/src/main/resources/application.properties.
# Never put real values in this file. See docs/adr/0004-config-from-environment.md.

# JDBC URL of the PostgreSQL database (ADR-0008). Supabase: use the "Session pooler" host
# (works without IPv6), port 5432, and require TLS:
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# Database user (Supabase session pooler: postgres.<project-ref>)
DB_USERNAME=
# Database password
DB_PASSWORD=
# Websites allowed to call the API, comma-separated, exact origins (no trailing slash)
CORS_ALLOWED_ORIGINS=https://<your-site>.netlify.app

# --- Sign-in (ADR-0005) ---
# Signs the login tokens. At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=
# First admin, created only when nobody can sign in yet. Password at least 12 characters.
# Leave ADMIN_PASSWORD empty locally to get a generated one printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Hosting (ADR-0008) ---
# Render sets PORT itself; leave it unset locally (the API uses 9001).
# PORT=
# Web app build setting, not read by the API: the API address baked into the site at build time.
# Set as a GitHub repository variable; not a secret.
# API_BASE_URL=https://<render-service>.onrender.com/api
